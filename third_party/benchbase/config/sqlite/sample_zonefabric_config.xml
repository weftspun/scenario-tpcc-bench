<?xml version="1.0"?>
<parameters>

    <!-- Connection details -->
    <type>SQLITE</type>
    <driver>org.sqlite.JDBC</driver>
    <url>jdbc:sqlite:zonefabric.db</url>
    <isolation>TRANSACTION_SERIALIZABLE</isolation>
    <batchsize>500</batchsize>

    <!-- Scale factor is the number of zones -->
    <scalefactor>5</scalefactor>

    <!-- Sequential loading only - see weftspun/mvsqlite-tpcc-bench's README
         for why concurrent loader threads hit unretried SQLITE_BUSY errors
         against mvsqlite. This loader already commits per zone/batch. -->
    <loaderThreads>1</loaderThreads>

    <!-- The workload -->
    <terminals>1</terminals>
    <works>
        <work>
            <time>60</time>
            <rate>10000</rate>
            <!-- CastSpell, ZoneAuthorityHandoff, EntityStateQuery, ZoneSplitMerge, InterestFanoutScan -->
            <weights>40,15,30,3,12</weights>
        </work>
    </works>

    <transactiontypes>
        <transactiontype>
            <name>CastSpell</name>
        </transactiontype>
        <transactiontype>
            <name>ZoneAuthorityHandoff</name>
        </transactiontype>
        <transactiontype>
            <name>EntityStateQuery</name>
        </transactiontype>
        <transactiontype>
            <name>ZoneSplitMerge</name>
        </transactiontype>
        <transactiontype>
            <name>InterestFanoutScan</name>
        </transactiontype>
    </transactiontypes>
</parameters>
