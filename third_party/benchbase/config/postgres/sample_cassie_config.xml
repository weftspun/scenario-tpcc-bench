<?xml version="1.0"?>
<parameters>

    <!-- Connection details -->
    <type>POSTGRES</type>
    <driver>org.postgresql.Driver</driver>
    <url>jdbc:postgresql://localhost:5432/benchbase?sslmode=disable&amp;ApplicationName=cassie&amp;reWriteBatchedInserts=true</url>
    <username>postgres</username>
    <password>postgres</password>
    <reconnectOnConnectionFailure>true</reconnectOnConnectionFailure>
    <isolation>TRANSACTION_SERIALIZABLE</isolation>
    <batchsize>128</batchsize>

    <!-- Scale factor is the number of concurrent canvases -->
    <scalefactor>5</scalefactor>

    <!-- The workload -->
    <terminals>1</terminals>
    <works>
        <work>
            <time>60</time>
            <rate>10000</rate>
            <!-- AppendStrokePoints, BeautifyStroke, CanvasSyncQuery, CanvasSnapshot, StrokeUndo -->
            <weights>40,15,30,3,12</weights>
        </work>
    </works>

    <transactiontypes>
        <transactiontype>
            <name>AppendStrokePoints</name>
        </transactiontype>
        <transactiontype>
            <name>BeautifyStroke</name>
        </transactiontype>
        <transactiontype>
            <name>CanvasSyncQuery</name>
        </transactiontype>
        <transactiontype>
            <name>CanvasSnapshot</name>
        </transactiontype>
        <transactiontype>
            <name>StrokeUndo</name>
        </transactiontype>
    </transactiontypes>
</parameters>
