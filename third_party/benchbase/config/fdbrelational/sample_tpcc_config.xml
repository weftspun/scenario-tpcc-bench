<?xml version="1.0"?>
<parameters>

    <!-- Connection details. The database/schema must already exist - run
         com.oltpbenchmark.util.fdbrelational.FdbRelSchemaBootstrap first, since FDB
         Relational's DDL dialect can't be bootstrapped through BenchBase's own
         connect-then-create-database flow (see DatabaseType.FDBRELATIONAL's javadoc).

         Uses FDB Relational Layer's EMBEDDED (in-process) driver, not the standalone
         fdb-relational-server + network/gRPC driver - run this benchmark via
         com.oltpbenchmark.util.fdbrelational.FdbRelEmbeddedLauncher (not
         `java -jar benchbase.jar` directly), which registers the embedded driver with
         DriverManager before delegating into BenchBase's own main(). No separate server
         process or port is needed; the JVM running BenchBase talks to FoundationDB
         directly and needs libfdb_c + FDB_CLUSTER_FILE like any direct FDB client.

         This runs BenchBase's own stock `tpcc` benchmark, unmodified, against FRL's
         type-mapped schema (see FdbRelSchemaBootstrap's javadoc for the DECIMAL/TIMESTAMP/
         CHAR->double/bigint/string mapping and its caveats) - the point is to see how much
         of TPCC's existing loader/procedures work as-is before building a purpose-built
         benchmark's own FRL integration on top. -->
    <type>FDBRELATIONAL</type>
    <driver>com.apple.foundationdb.relational.api.EmbeddedRelationalDriver</driver>
    <url>jdbc:embed:/FRL/tpcc?schema=PUBLIC</url>
    <username></username>
    <password></password>
    <isolation>TRANSACTION_SERIALIZABLE</isolation>
    <batchsize>128</batchsize>

    <!-- Scale factor is the number of warehouses in TPCC -->
    <scalefactor>1</scalefactor>

    <!-- The workload -->
    <terminals>1</terminals>
    <works>
        <work>
            <time>60</time>
            <rate>10000</rate>
            <weights>45,43,4,4,4</weights>
        </work>
    </works>

    <!-- TPCC specific -->
    <transactiontypes>
        <transactiontype>
            <name>NewOrder</name>
        </transactiontype>
        <transactiontype>
            <name>Payment</name>
        </transactiontype>
        <transactiontype>
            <name>OrderStatus</name>
        </transactiontype>
        <transactiontype>
            <name>Delivery</name>
        </transactiontype>
        <transactiontype>
            <name>StockLevel</name>
        </transactiontype>
    </transactiontypes>
</parameters>
